{
  "name": "dsh-plugin-writing-guard",
  "version": "2.0.2",
  "description": "面向 AI 辅助科研的科学写作与文档完整性守卫：提示词引导的论证经济性，配合确定性的科学、交付、期刊与 Word 完整性检查。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src/word_guard",
    "skills",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node tests/run-tests.mjs",
    "postinstall": "node scripts/install-extras.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmutfyh/dsh-plugin-writing-guard.git"
  },
  "homepage": "https://github.com/xmutfyh/dsh-plugin-writing-guard#readme",
  "bugs": {
    "url": "https://github.com/xmutfyh/dsh-plugin-writing-guard/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "academic-writing",
    "scientific-writing",
    "research-paper",
    "ai-writing",
    "scientific-integrity",
    "journal-fit",
    "deepseek-harness",
    "docx",
    "microsoft-word",
    "ooxml",
    "document-integrity",
    "document-processing",
    "manuscript",
    "proofreading"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
