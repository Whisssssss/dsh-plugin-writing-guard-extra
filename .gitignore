# Dependencies — never commit
node_modules/

# Build artifacts of deps (pnpm virtual store lives in node_modules)

# Editor / OS noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# TypeScript incremental build info
*.tsbuildinfo

# NOTE: lib/ IS committed on purpose — DSH plugins install from GitHub
# tarballs without a build step (same convention as dsh-proof /
# dsh-custom-tool). Keep compiled output in sync with src/ on every release.

# Codex task runner output
.codex-last-message.md
__pycache__/
*.pyc
node_modules/

# lib/ is mostly ignored, but the compiled JS is committed on purpose (see note
# above). The Python word_guard module is a runtime asset of lib/index.js
# (it resolves ./word_guard/cli.py), so it must ship with lib/ as well.
lib/
!lib/
lib/*
!lib/word_guard/
!lib/word_guard/**
